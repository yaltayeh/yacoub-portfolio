{
	"name": "yacoub-portfolio",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.12.0",
	"dependencies": {
		"@vinext/cloudflare": "1.0.1",
		"drizzle-orm": "0.45.4",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-server-dom-webpack": "19.3.0",
		"vinext": "1.0.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.63.0",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitejs/plugin-rsc": "0.5.36",
		"drizzle-kit": "0.31.11",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"wrangler": "4.148.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vinext dev",
		"build": "vinext build",
		"start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
		"deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
		"preview": "pnpm run build && pnpm run start",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:preview": "wrangler d1 migrations apply DB --remote --env preview",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote"
	}
}
